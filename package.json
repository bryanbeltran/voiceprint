{
  "name": "voiceprint",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first, open personal voice compiler for AI tools.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "verify": "node scripts/verify.mjs",
    "voiceprint": "tsx scripts/voiceprint.ts",
    "voiceprint:audit": "tsx scripts/voiceprint.ts audit"
  },
  "bin": {
    "voiceprint": "scripts/voiceprint.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "jsdom": "^27.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.11",
    "vitest": "^5.0.5"
  }
}
